# Server
PORT=5000
NODE_ENV=development

# Client (for CORS)
CLIENT_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/localhire

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — Translation (Phase 2). If absent, chat falls back to a
# small local phrase dictionary instead of failing.
GOOGLE_TRANSLATE_API_KEY=

# Optional — Speech-to-Text (Phase 5, Voice-to-Job-Posting). If absent,
# that feature falls back to the manual job-posting form.
SPEECH_TO_TEXT_API_KEY=